# Camera: 0 = webcam tích hợp, 1 = cam ngoài USB, hoặc rtsp://user:pass@ip:554/stream, hoặc http://ip:port/video
CAMERA_SOURCE=0

# Độ phân giải mong muốn từ camera (Hỗ trợ camera dọc 1080x1920 hoặc ngang 1920x1080)
CAMERA_WIDTH=1080
CAMERA_HEIGHT=1920

# YOLO weights (sau khi train đặt vào models/best_uniform_model.pt)
MODEL_PATH=models/best_uniform_model.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45

# Kích thước suy luận YOLO (640, 960, 1280) - 960/1280 giúp bắt thẻ tên siêu nhỏ
IMGSZ=960

# Khoảng cách tối thiểu của học sinh (chiều cao bbox px) để kích hoạt kiểm tra
MIN_STUDENT_HEIGHT=250

# Yêu cầu khăn quàng đỏ (true: Cấp 1, 2; false: Cấp 3 / THPT)
REQUIRE_SCARF=false

# Hiển thị cửa sổ preview (true/false)
SHOW_PREVIEW=true

# --- Tích hợp điểm danh OhStem IoT ---
OHSTEM_USERNAME=your_ohstem_username
OHSTEM_PASSWORD=  # Để trống nếu không có mật khẩu MQTT
OHSTEM_FEED_ID=V1  # Kênh nhận số lượng điểm danh (sĩ số)
ENABLE_OHSTEM=false  # Đổi thành true để kích hoạt gửi lên OhStem
